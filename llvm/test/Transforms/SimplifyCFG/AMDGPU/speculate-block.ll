; NOTE: Assertions have been autogenerated by utils/update_test_checks.py UTC_ARGS: --version 6
; RUN: opt -S -passes=simplifycfg -mtriple=amdgpu9.0a-amd-amdhsa < %s | FileCheck %s

; Test SimplifyCFG speculation of a block that requires a <4 x float> select on
; AMDGPU. A divergent branch costs exec mask manipulation, which is credited to
; the speculation budget, so it gets speculated. A uniform branch is cheap and
; the select costs one v_cndmask per element, so the branch is kept.

define amdgpu_kernel void @uniform(i1 %arg3, i1 %icmp84) {
; CHECK-LABEL: define amdgpu_kernel void @uniform(
; CHECK-SAME: i1 [[ARG3:%.*]], i1 [[ICMP84:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[ARG3]], label %[[THEN:.*]], label %[[MERGE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[ICMP841:%.*]] = icmp sge i32 0, 0
; CHECK-NEXT:    br i1 [[ICMP84]], label %[[THEN_IF:.*]], label %[[MERGE]]
; CHECK:       [[THEN_IF]]:
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[PHI92:%.*]] = phi <4 x float> [ zeroinitializer, %[[THEN_IF]] ], [ splat (float 1.000000e+00), %[[THEN]] ], [ zeroinitializer, %[[ENTRY]] ]
; CHECK-NEXT:    ret void
;
entry:
  br i1 %arg3, label %then, label %merge

then:                                             ; preds = %entry
  %icmp841 = icmp sge i32 0, 0
  br i1 %icmp84, label %then.if, label %merge

then.if:                                          ; preds = %then
  br label %merge

merge:                                            ; preds = %then.if, %then, %entry
  %phi92 = phi <4 x float> [ zeroinitializer, %then.if ], [ splat (float 1.000000e+00), %then ], [ zeroinitializer, %entry ]
  ret void
}

define amdgpu_kernel void @divergent(i1 %arg3, i32 %x) {
; CHECK-LABEL: define amdgpu_kernel void @divergent(
; CHECK-SAME: i1 [[ARG3:%.*]], i32 [[X:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br i1 [[ARG3]], label %[[THEN:.*]], label %[[MERGE:.*]]
; CHECK:       [[THEN]]:
; CHECK-NEXT:    [[TID:%.*]] = call i32 @llvm.amdgcn.workitem.id.x()
; CHECK-NEXT:    [[ICMP84:%.*]] = icmp slt i32 [[TID]], [[X]]
; CHECK-NEXT:    [[SPEC_SELECT:%.*]] = select i1 [[ICMP84]], <4 x float> zeroinitializer, <4 x float> splat (float 1.000000e+00)
; CHECK-NEXT:    br label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[PHI92:%.*]] = phi <4 x float> [ zeroinitializer, %[[ENTRY]] ], [ [[SPEC_SELECT]], %[[THEN]] ]
; CHECK-NEXT:    ret void
;
entry:
  br i1 %arg3, label %then, label %merge

then:                                             ; preds = %entry
  %tid = call i32 @llvm.amdgcn.workitem.id.x()
  %icmp84 = icmp slt i32 %tid, %x
  br i1 %icmp84, label %then.if, label %merge

then.if:                                          ; preds = %then
  br label %merge

merge:                                            ; preds = %then.if, %then, %entry
  %phi92 = phi <4 x float> [ zeroinitializer, %then.if ], [ splat (float 1.000000e+00), %then ], [ zeroinitializer, %entry ]
  ret void
}
